// --- Logging ---
logging {
  level = "info"
}

// ###############################
// #### Metrics Configuration ####
// ###############################

// Scrape TempMsgChatApp app custom metrics
prometheus.scrape "fake_vinted" {
  scrape_interval          = "10s"
  scheme                   = "http"
  metrics_path             = "/metrics"
  scrape_native_histograms = true

  targets = [
    { __address__          = "ms_gateway:5000" },
    { __address__          = "ms_listing:4001" },
    { __address__          = "ms_chat:4002" },
    { __address__          = "ms_notifications:4003" },
  ]

  forward_to = [prometheus.remote_write.metrics.receiver]

}

// Scrape Pushgateway app custom metrics
prometheus.scrape "pushgateway" {
  scrape_interval = "10s"

  targets = [
    { __address__ = "pushgateway:9091" },
  ]

  forward_to = [prometheus.relabel.pushgateway_metrics.receiver]
}

// ##################################################
// #### Prometheus relabel Configuration Section ####
// ##################################################
prometheus.relabel "pushgateway_metrics" {
  forward_to = [prometheus.remote_write.metrics.receiver]
}

// --- Remote write to Prometheus ---
prometheus.remote_write "metrics" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ###############################
// #### Loki Configuration ####
// ###############################
// Finds the containers through the docker socket, so a new service needs no changes here
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // only this project's containers
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "fake-vinted"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

// Reads what the containers write to stdout and stderr
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}

// --- Loki destination ---
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

